# =============================================================================
# Production env — copy on server (never commit real secrets)
#
# Next.js:  /www/wwwroot/ai-speaking-trainer/.env.local
# Python:    /www/wwwroot/ai-speaking-trainer/python/.env
# =============================================================================

# --- .env.local (Next.js) ---
NEXT_PUBLIC_APP_NAME=AI Speaking Trainer
NEXT_PUBLIC_APP_URL=https://YOUR_DOMAIN
INTERNAL_APP_URL=http://127.0.0.1:3000

# Auth (required). Accounts are stored as JSON files under DATA_DIR — no Postgres.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_COOKIE_NAME=speaking_session
AUTH_SESSION_DAYS=30
# Optional comma-separated admin emails (also checked via is_admin on user file)
# ADMIN_EMAILS=you@example.com

# File data root: users / practices / surveys
# DATA_DIR=/data/app

# Audio files (per-user folders under this directory)
NEXT_PUBLIC_AUDIO_STORAGE=local
AUDIO_STORAGE_DIR=/data/audio

PYTHON_SPEECH_API_URL=http://127.0.0.1:8000
PYTHON_SPEECH_API_KEY=choose-a-long-random-secret
PYTHON_SPEECH_API_TIMEOUT_MS=300000

# --- python/.env ---
GLM_API_KEY=your_zhipu_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4.7-flashx

ASSEMBLYAI_API_KEY=your_assemblyai_key
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_SPEECH_MODELS=universal-2

PYTHON_SPEECH_API_KEY=same-as-nextjs-above
CORS_ORIGINS=https://YOUR_DOMAIN
DEV_ECHO_REFERENCE=false
LOG_LEVEL=INFO

# Verify: curl https://YOUR_DOMAIN/api/health/auth
# Expect: authConfigured=true, storage=file, databaseReachable=true
