# =============================================================================
# AI Speaking Trainer — environment template
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME=AI Speaking Trainer
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Self-hosted auth + database (replaces Supabase Auth)
# Server only — never use NEXT_PUBLIC_ for secrets
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://speaking_app:your-password@127.0.0.1:5432/speaking_trainer
AUTH_SECRET=generate-with-openssl-rand-base64-32
# AUTH_COOKIE_NAME=speaking_session
# AUTH_SESSION_DAYS=30

# -----------------------------------------------------------------------------
# Audio storage (Phase 3 — local upload replaces Supabase Storage)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_AUDIO_STORAGE=local
# AUDIO_STORAGE_DIR=/data/audio
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=audio-responses

# Optional: server-side admin writes (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Python speech analysis (Listen & Repeat + Virtual Interview)
# Transcription: Tencent/AssemblyAI/Whisper/mock (python/.env) | Speech evaluation: Tencent SOE/mock (python/.env) | Scoring: Zhipu GLM (python/.env)
# -----------------------------------------------------------------------------
PYTHON_SPEECH_API_URL=http://localhost:8000
# PYTHON_SPEECH_API_KEY=your-python-api-bearer-token
# PYTHON_SPEECH_API_TIMEOUT_MS=300000

# OPENAI_API_KEY is not required when using the Python service (see python/.env)
