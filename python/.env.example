# --- 智谱 GLM 打分 ---
GLM_API_KEY=你的智谱key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_NAME=glm-4.7-flashx
# 关闭思考链，评分更快（默认 disabled）
# GLM_THINKING=disabled
# 限制输出长度，避免 JSON 过长拖慢（Interview 一般够用）
# GLM_MAX_OUTPUT_TOKENS=8192
# GLM_TIMEOUT_SECONDS=120

# --- Speech-to-text provider ---
# Use mock for local development without cloud credentials.  Use tencent in
# production after providing both Tencent credentials below.  auto preserves
# the legacy AssemblyAI/Whisper fallback when those credentials are present.
ASR_PROVIDER=mock

# --- Tencent ASR (Phase 1) ---
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_en
# TENCENT_ASR_ENDPOINT=https://asr.tencentcloudapi.com
# TENCENT_ASR_TIMEOUT_SECONDS=120
# TENCENT_ASR_POLL_INTERVAL_SECONDS=1

# --- AssemblyAI 转写（legacy fallback）---
ASSEMBLYAI_API_KEY=你的AssemblyAIKey
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_SPEECH_MODELS=universal-2

# --- Whisper 转写（可选）---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1

# --- Legacy debug flag (recorded responses still require a configured provider) ---
DEV_ECHO_REFERENCE=true

# --- Deterministic local ASR ---
# MOCK_ASR_TRANSCRIPT=I think this is a useful practice response for local development.
# MOCK_ASR_DURATION_SECONDS=6

# --- 可选 ---
# LOG_LEVEL=INFO
# PYTHON_SPEECH_API_KEY=
# CORS_ORIGINS=http://localhost:3000
